# Server-only settings. Copy this file to .env.local.
OLLAMA_BASE_URL=http://127.0.0.1:11434
JUNE_BACKEND_URL=http://127.0.0.1:8001
# Optional: override the private wake-model folder (normally beside speech).
# JUNE_REALTIME_HOME=/absolute/path/private/realtime
JUNE_MODEL=qwen2.5:1.5b

# Optional private runtime location. The default is ~/Library/Application Support/June/speech.
# JUNE_SPEECH_HOME=/absolute/path/to/private/speech
