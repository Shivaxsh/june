{
  "name": "june",
  "version": "0.5.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/start.mjs dev",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs production",
    "typecheck": "tsc --noEmit",
    "model:start": "node scripts/model.mjs serve",
    "model:pull": "node scripts/model.mjs pull",
    "test": "node --test tests/*.test.mjs",
    "speech:setup": "node scripts/speech.mjs setup",
    "speech:check": "node scripts/speech.mjs check",
    "backend:setup": "node scripts/backend.mjs setup",
    "backend:start": "node scripts/backend.mjs start",
    "backend:check": "node scripts/backend.mjs check",
    "backend:test": "PYTHONPATH=backend backend/.venv/bin/python -m unittest discover -s backend/tests -v",
    "realtime:setup": "node scripts/realtime.mjs",
    "audio:setup": "node scripts/audio.mjs",
    "speech:worker:setup": "node scripts/speech-worker.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "typescript": "5.9.3"
  }
}
